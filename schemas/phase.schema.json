{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/phase.schema.json",
  "title": "Application phase",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase_id", "tax_id", "change_id", "phase_sequence", "subject_scope", "rate_or_amount", "value", "application_start", "application_start_raw", "application_start_source_url", "collection_start", "collection_start_raw", "collection_start_source_url", "transitional_rule", "source_refs", "evidence_gaps", "verified_at"],
  "properties": {
    "phase_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "tax_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "change_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "phase_sequence": {"type": "integer", "minimum": 1},
    "subject_scope": {"type": "string", "minLength": 1},
    "rate_or_amount": {"type": "string", "minLength": 1},
    "value": {"$ref": "#/$defs/value"},
    "application_start": {"type": ["string", "null"], "format": "date"},
    "application_start_raw": {"type": "string", "minLength": 1},
    "application_start_source_url": {"type": "string", "format": "uri"},
    "application_end": {"type": ["string", "null"], "format": "date"},
    "collection_start": {"type": ["string", "null"], "format": "date"},
    "collection_start_raw": {"type": "string", "minLength": 1},
    "collection_start_source_url": {"type": "string", "format": "uri"},
    "collection_end": {"type": ["string", "null"], "format": "date"},
    "transitional_rule": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"anyOf": [{"properties": {"application_start": {"type": "null"}}, "required": ["application_start"]}, {"properties": {"collection_start": {"type": "null"}}, "required": ["collection_start"]}]},
      "then": {"properties": {"evidence_gaps": {"type": "array", "minItems": 1}}}
    }
  ],
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "numeric_value", "unit", "raw", "value_status", "scope"],
      "properties": {
        "kind": {"enum": ["rate", "amount", "formula", "unknown"]},
        "numeric_value": {"type": ["number", "null"]},
        "unit": {"enum": ["percent", "yen", "yen_per_month", "yen_per_year", "formula", "unknown"]},
        "raw": {"type": "string", "minLength": 1},
        "value_status": {"enum": ["confirmed", "provisional", "estimated", "unknown"]},
        "scope": {"type": "string", "minLength": 1},
        "evidence_gap_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"value_status": {"const": "unknown"}}, "required": ["value_status"]}, "then": {"properties": {"evidence_gap_reason": true}, "required": ["evidence_gap_reason"]}}]
    }
  }
}
