{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/social-insurance-adapters.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","verified_at","implementation_issue","targets"],
  "properties":{
    "schema_version":{"const":1},"verified_at":{"$ref":"common.schema.json#/$defs/verifiedAt"},"implementation_issue":{"const":44},
    "targets":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"#/$defs/target"}}
  },
  "$defs":{
    "target":{"type":"object","additionalProperties":false,"required":["tax_id","status"],"properties":{
      "tax_id":{"$ref":"common.schema.json#/$defs/id"},"status":{"enum":["implemented","held"]},
      "source_ids":{"$ref":"common.schema.json#/$defs/sourceIds"},
      "government_contribution_handling":{"const":"excluded_from_premium_total"},
      "period_fact_ids":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
      "components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}},"hold_reason":{"$ref":"common.schema.json#/$defs/holdReason"},"follow_up_issue":{"type":"integer","minimum":1}
    },"allOf":[
      {"if":{"properties":{"status":{"const":"implemented"}}},"then":{"required":["source_ids","government_contribution_handling","components"],"properties":{"source_ids":{},"government_contribution_handling":{},"components":{}}}},
      {"if":{"properties":{"status":{"const":"held"}}},"then":{"required":["hold_reason","follow_up_issue"],"properties":{"hold_reason":{},"follow_up_issue":{}}}}
    ]},
    "component":{"type":"object","additionalProperties":false,"required":["component_id","scope","role","calculation_basis","numeric_value","unit","aggregation_role","included_in_total","period_start","period_end","value_status","source_id","fact_id"],"properties":{
      "component_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"scope":{"type":"string","minLength":1},
      "role":{"enum":["combined_total","insured_worker","insured_person","employer"]},"calculation_basis":{"type":"string","minLength":1},"numeric_value":{"type":"number","minimum":0},
      "unit":{"enum":["percent","per_thousand","yen_per_month"]},"aggregation_role":{"enum":["total","part","standalone"]},
      "included_in_total":{"type":"boolean"},"period_start":{"type":"string","format":"date"},"period_end":{"type":["string","null"],"format":"date"},
      "value_status":{"enum":["official_current","derived_exact"]},"source_id":{"$ref":"common.schema.json#/$defs/id"},"fact_id":{"$ref":"common.schema.json#/$defs/id"}
    }}
  }
}
