{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/monitoring-runtime.schema.json",
  "title": "Runtime monitoring plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tax_id", "monitoring_mode", "enabled", "cadence", "municipal_scope", "sources", "notes"],
      "properties": {
        "tax_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "monitoring_mode": {"enum": ["automated", "manual", "out_of_scope"]},
        "enabled": {"type": "boolean"},
        "cadence": {"type": "string", "minLength": 1},
        "municipal_scope": {"enum": ["national_only", "issue_20"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"monitoring_mode": {"enum": ["automated", "manual"]}}}, "then": {"properties": {"sources": {"type": "array", "minItems": 1}}}},
        {"if": {"properties": {"monitoring_mode": {"const": "out_of_scope"}}}, "then": {"properties": {"enabled": {"const": false}}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "target_url", "enabled", "adapter", "target_id", "extraction_targets"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "target_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "enabled": {"type": "boolean"},
        "adapter": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "change_detection": {"$ref": "#/$defs/changeDetection"},
        "extraction_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/structuredExtractionTarget"}]}}
      },
      "allOf": [
        {"if": {"properties": {"change_detection": {}}, "required": ["change_detection"]}, "then": {"properties": {"extraction_targets": {"type": "array", "items": {"$ref": "#/$defs/structuredExtractionTarget"}}}}}
      ]
    },
    "changeDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_format", "revision_id_path", "updated_at_path", "comparison"],
      "properties": {
        "document_format": {"const": "egov_law_api_v2_json"},
        "revision_id_path": {"type": "string", "pattern": "^/"},
        "updated_at_path": {"type": "string", "pattern": "^/"},
        "comparison": {"const": "selected_nodes_sha256"}
      }
    },
    "structuredExtractionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "description", "selector", "comparison"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/egovNodeSelector"},
        "comparison": {"const": "canonical_json_sha256"}
      }
    },
    "egovNodeSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_path", "scope_tag", "tag", "attribute", "values"],
      "properties": {
        "root_path": {"const": "/law_full_text"},
        "scope_tag": {"const": "MainProvision"},
        "tag": {"const": "Article"},
        "attribute": {"const": "Num"},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+(?:_[0-9]+)?$"}}
      }
    }
  }
}
