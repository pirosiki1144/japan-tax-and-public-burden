{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/burden.schema.json",
  "title": "Tax or public burden",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_id", "official_name", "aliases", "burden_type", "legal_mandate_type", "jurisdiction", "liable_party", "economic_bearer", "collector", "purpose", "calculation_basis", "current_status", "legal_bases", "current_phases", "pending_changes", "source_refs", "coverage_status", "evidence_gaps", "verified_at"],
  "properties": {
    "tax_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "official_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "burden_type": {"enum": ["national_tax", "local_tax", "social_insurance_premium", "levy", "contribution", "burden_charge", "payment", "adjustment_charge", "insurance_premium", "fee", "other"]},
    "legal_mandate_type": {"enum": ["mandatory_by_law", "mandatory_by_regulation", "mandatory_by_ordinance", "contractual_or_private_rule", "indirect_pass_through", "unknown"]},
    "jurisdiction": {"type": "string", "minLength": 1},
    "liable_party": {"type": "string", "minLength": 1},
    "economic_bearer": {"type": "string", "minLength": 1},
    "collector": {"type": "string", "minLength": 1},
    "beneficiary_or_fund": {"type": ["string", "null"]},
    "purpose": {"type": "string"},
    "calculation_basis": {"type": "string"},
    "current_status": {"enum": ["not_applied", "active", "active_with_pending_change", "ended"]},
    "legal_bases": {"type": "array", "items": {"$ref": "#/$defs/legalBase"}},
    "current_phases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "pending_changes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "coverage_status": {"enum": ["confirmed", "candidate", "needs_review", "excluded"]},
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "legalBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_url"],
      "properties": {"law_id": {"type": ["string", "null"]}, "name": {"type": "string"}, "article": {"type": ["string", "null"]}, "source_url": {"type": "string", "format": "uri"}}
    }
  }
}
