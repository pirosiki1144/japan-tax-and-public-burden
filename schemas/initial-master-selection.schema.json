{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/initial-master-selection.schema.json",
  "title": "Initial master selection configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue", "decided_at", "law_sources_verified_at", "candidate_files", "default_decision", "existing_merges", "identity_reviews", "law_sources"],
  "properties": {
    "schema_version": {"const": 1},
    "issue": {"type": "integer", "minimum": 1},
    "decided_at": {"type": "string", "format": "date"},
    "law_sources_verified_at": {"type": "string", "format": "date-time"},
    "candidate_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^data/candidates/[a-z0-9-]+\\.yaml$"}},
    "default_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reason"],
      "properties": {"disposition": {"enum": ["insert", "hold", "excluded"]}, "reason": {"type": "string", "minLength": 1}}
    },
    "existing_merges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "existing_tax_id", "reason"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "existing_tax_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "identity_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_ids", "relation", "reason"],
        "properties": {
          "candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
          "relation": {"enum": ["same", "distinct", "needs_review"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "law_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_ids", "law_titles", "source_urls"],
        "properties": {
          "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
          "law_titles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://laws\\.e-gov\\.go\\.jp/api/2/law_data/[A-Z0-9]+$"}}
        }
      }
    }
  }
}
