{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/source.schema.json",
  "title": "Source registry",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "authority", "base_url", "entry_urls", "source_type", "scope", "jurisdiction", "priority", "cadence", "enabled", "adapter", "rate_limit", "terms_url", "last_verified_at"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "entry_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
        "source_type": {"enum": ["law_api", "official_gazette", "bill_index", "parliamentary_schedule", "parliamentary_minutes", "cabinet", "ministry", "public_agency", "council", "statistics", "party", "news", "municipal_gazette"]},
        "scope": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 1},
        "cadence": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "automation_enabled": {"type": "boolean"},
        "monitoring_tax_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "adapter": {"type": "string", "minLength": 1},
        "accepted_content_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "extraction": {"$ref": "#/$defs/extraction"},
        "rate_limit": {"type": "string", "minLength": 1},
        "terms_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "last_verified_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"automation_enabled": {"const": true}}, "required": ["automation_enabled"]},
          "then": {"properties": {"extraction": true}, "required": ["extraction"]}
        }
      ]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_pages", "required_markers", "facts"],
      "properties": {
        "expected_pages": {"type": "integer", "minimum": 1},
        "required_markers": {"type": "array", "items": {"$ref": "#/$defs/marker"}},
        "expected_documents": {"type": "array", "items": {"$ref": "#/$defs/expectedDocument"}},
        "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_index", "label", "pattern"],
      "properties": {
        "page_index": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "page_index", "pattern", "capture_group", "transform"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "page_index": {"type": "integer", "minimum": 0},
        "pattern": {"type": "string", "minLength": 1},
        "capture_group": {"type": "integer", "minimum": 1},
        "transform": {"enum": ["string", "number", "japanese_number", "japanese_date", "japanese_year_month", "iso_date_components", "fiscal_year_start", "fiscal_year_end"]},
        "article_num": {"type": "string", "minLength": 1},
        "article_caption": {"type": "string", "minLength": 1},
        "item_num": {"type": "string", "minLength": 1},
        "expected_value": {"type": ["string", "number"]},
        "target": {"$ref": "#/$defs/target"}
      },
      "anyOf": [
        {"properties": {"target": true}, "required": ["target"]},
        {"properties": {"expected_value": true}, "required": ["expected_value"]}
      ]
    },
    "expectedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_index", "law_id", "law_title"],
      "properties": {
        "page_index": {"type": "integer", "minimum": 0},
        "law_id": {"type": "string", "minLength": 1},
        "law_title": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "record_id_field", "record_id", "path"],
      "properties": {
        "file": {"type": "string", "pattern": "^data/[a-z0-9_./-]+\\.(?:yaml|yml|json)$"},
        "record_id_field": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "record_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "path": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*(?:\\.(?:[a-z_][a-z0-9_]*|[0-9]+))*$"}
      }
    }
  }
}
