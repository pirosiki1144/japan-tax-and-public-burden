{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/format-adapters.schema.json",
  "title": "Official document format adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "formats"],
  "properties": {
    "schema_version": {"const": 1},
    "formats": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "adapter", "status", "mime_types"],
        "properties": {
          "format": {"enum": ["html", "pdf", "csv", "spreadsheet"]},
          "adapter": {"type": "string", "minLength": 1},
          "status": {"enum": ["implemented", "manual"]},
          "mime_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
          "implementation": {"type": "string", "pattern": "^scripts/"},
          "manual_reason": {"type": "string", "minLength": 20}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "implemented"}}}, "then": {"required": ["implementation"], "properties": {"implementation": {}}}},
          {"if": {"properties": {"status": {"const": "manual"}}}, "then": {"required": ["manual_reason"], "properties": {"adapter": {"const": "manual"}, "manual_reason": {}}}}
        ]
      }
    }
  }
}
