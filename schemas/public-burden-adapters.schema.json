{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/public-burden-adapters.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","verified_at","implementation_issue","implemented_targets","manual_targets","held_groups"],
  "properties":{
    "schema_version":{"const":1},"verified_at":{"$ref":"common.schema.json#/$defs/verifiedAt"},"implementation_issue":{"const":45},
    "implemented_targets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/implemented"}},
    "manual_targets":{"type":"array","items":{"$ref":"#/$defs/manual"}},
    "held_groups":{"type":"array","items":{"$ref":"#/$defs/heldGroup"}}
  },
  "$defs":{
    "id":{"$ref":"common.schema.json#/$defs/id"},
    "implemented":{"type":"object","additionalProperties":false,"required":["tax_id","source_ids","components"],"properties":{"tax_id":{"$ref":"common.schema.json#/$defs/id"},"source_ids":{"$ref":"common.schema.json#/$defs/sourceIds"},"components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}},"lifecycle":{"$ref":"#/$defs/lifecycle"}}},
    "heldGroup":{"type":"object","additionalProperties":false,"required":["group_id","tax_ids","hold_reason"],"properties":{"group_id":{"$ref":"common.schema.json#/$defs/id"},"tax_ids":{"$ref":"common.schema.json#/$defs/sourceIds"},"hold_reason":{"type":"string","minLength":30}}},
    "manual":{"type":"object","additionalProperties":false,"required":["tax_id","official_source_url","value_scope","evidence_gap","release_conditions","recheck_cadence"],"properties":{"tax_id":{"$ref":"common.schema.json#/$defs/id"},"official_source_url":{"type":"string","format":"uri","pattern":"^https://"},"value_scope":{"type":"string","minLength":20},"evidence_gap":{"$ref":"common.schema.json#/$defs/holdReason"},"release_conditions":{"type":"array","minItems":1,"items":{"type":"string","minLength":10}},"recheck_cadence":{"enum":["monthly","quarterly","annual"]},"lifecycle":{"$ref":"#/$defs/lifecycle"}}},
    "lifecycle":{"type":"object","additionalProperties":false,"required":["current_state","promulgation","enforcement","application_start","collection_start","release_events","next_review_on"],"properties":{"current_state":{"enum":["pre_enforcement","active_individual_decision","active_conditional","active_official_value"]},"promulgation":{"$ref":"#/$defs/dateEvidence"},"enforcement":{"$ref":"#/$defs/dateEvidence"},"application_start":{"$ref":"#/$defs/dateEvidence"},"collection_start":{"$ref":"#/$defs/dateEvidence"},"release_events":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["enforcement_reached","first_unit_price_published","annual_amount_approved","triggering_damage_confirmed"]}},"next_review_on":{"type":"string","format":"date"}}},
    "dateEvidence":{"type":"object","additionalProperties":false,"required":["value","raw","precision","certainty","source_url"],"properties":{"value":{"type":["string","null"],"format":"date"},"raw":{"type":"string","minLength":1},"precision":{"enum":["exact_date","fiscal_year","condition_based","unknown"]},"certainty":{"enum":["enacted","official_current","unknown"]},"source_url":{"type":"string","format":"uri","pattern":"^https://"}}},
    "component":{"type":"object","additionalProperties":false,"required":["component_id","liable_party_role","subject_scope","calculation_basis","calculation_kind","unit","aggregation_role","included_in_total","period_start","period_end","period_precision","value_status","source_id","fact_id"],"properties":{"component_id":{"$ref":"#/$defs/id"},"liable_party_role":{"enum":["employer","operator","insured_person","consumer","education_provider","telecommunications_carrier","product_marketing_authorization_holder","other"]},"subject_scope":{"type":"string","minLength":1},"calculation_basis":{"type":"string","minLength":1},"calculation_kind":{"enum":["fixed_amount_per_unit","rate","formula"]},"numeric_value":{"type":"number","minimum":0},"formula_raw":{"type":"string","minLength":3},"unit":{"enum":["yen_per_person_month","yen_per_student_year","yen_per_number_month","yen","percent","per_thousand","ratio","yen_per_kwh"]},"aggregation_role":{"enum":["total","part","standalone"]},"included_in_total":{"type":"boolean"},"period_start":{"type":["string","null"],"format":"date"},"period_end":{"type":["string","null"],"format":"date"},"period_precision":{"enum":["exact","month","fiscal_year","current_rule_no_effective_date_on_overview","unknown"]},"value_status":{"enum":["official_current","derived_exact"]},"source_id":{"$ref":"#/$defs/id"},"fact_id":{"$ref":"#/$defs/id"}},"allOf":[{"if":{"properties":{"calculation_kind":{"const":"formula"}}},"then":{"properties":{"formula_raw":{}},"required":["formula_raw"]},"else":{"properties":{"numeric_value":{}},"required":["numeric_value"]}}]}
  }
}
