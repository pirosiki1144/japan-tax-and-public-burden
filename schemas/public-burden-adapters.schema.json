{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/public-burden-adapters.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","verified_at","implementation_issue","implemented_targets","held_groups"],
  "properties":{
    "schema_version":{"const":1},"verified_at":{"type":"string","format":"date-time"},"implementation_issue":{"const":45},
    "implemented_targets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/implemented"}},
    "held_groups":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/heldGroup"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "implemented":{"type":"object","additionalProperties":false,"required":["tax_id","source_ids","components"],"properties":{"tax_id":{"$ref":"#/$defs/id"},"source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}}}},
    "heldGroup":{"type":"object","additionalProperties":false,"required":["group_id","tax_ids","hold_reason"],"properties":{"group_id":{"$ref":"#/$defs/id"},"tax_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"hold_reason":{"type":"string","minLength":30}}},
    "component":{"type":"object","additionalProperties":false,"required":["component_id","liable_party_role","subject_scope","calculation_basis","calculation_kind","numeric_value","unit","aggregation_role","included_in_total","period_start","period_end","period_precision","value_status","source_id","fact_id"],"properties":{"component_id":{"$ref":"#/$defs/id"},"liable_party_role":{"enum":["employer","operator","insured_person","consumer","other"]},"subject_scope":{"type":"string","minLength":1},"calculation_basis":{"type":"string","minLength":1},"calculation_kind":{"enum":["fixed_amount_per_unit","rate","formula"]},"numeric_value":{"type":"number","minimum":0},"unit":{"enum":["yen_per_person_month","yen","percent","per_thousand","yen_per_kwh"]},"aggregation_role":{"enum":["total","part","standalone"]},"included_in_total":{"type":"boolean"},"period_start":{"type":["string","null"],"format":"date"},"period_end":{"type":["string","null"],"format":"date"},"period_precision":{"enum":["exact","fiscal_year","current_rule_no_effective_date_on_overview","unknown"]},"value_status":{"enum":["official_current","derived_exact"]},"source_id":{"$ref":"#/$defs/id"},"fact_id":{"$ref":"#/$defs/id"}}}
  }
}
