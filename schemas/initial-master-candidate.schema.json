{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/initial-master-candidate.schema.json",
  "title": "Initial master candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "name_raw", "official_name", "aliases", "burden_type", "legal_mandate_type", "jurisdiction", "liable_party", "collectors", "current_status", "coverage_status", "source_urls", "verified_at", "evidence_gaps", "decision_note"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name_raw": {"type": "string", "minLength": 1},
    "official_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "burden_type": {"enum": ["national_tax", "local_tax", "social_insurance_premium", "levy", "contribution", "burden_charge", "payment", "adjustment_charge", "insurance_premium", "fee", "other"]},
    "legal_mandate_type": {"enum": ["mandatory_by_law", "mandatory_by_regulation", "mandatory_by_ordinance", "contractual_or_private_rule", "indirect_pass_through", "unknown"]},
    "jurisdiction": {"type": "string", "minLength": 1},
    "liable_party": {"type": "string", "minLength": 1},
    "collectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "responsible_authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "legal_basis_notes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_status": {"type": ["string", "null"], "enum": ["not_applied", "active", "active_with_pending_change", "ended", null]},
    "coverage_status": {"enum": ["confirmed", "candidate", "needs_review", "excluded"]},
    "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
    "verified_at": {"type": "string", "format": "date-time"},
    "evidence_gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_note": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"coverage_status": {"const": "confirmed"}}, "required": ["coverage_status"]},
      "then": {
        "properties": {
          "official_name": {"not": {"const": "unknown"}},
          "legal_mandate_type": {"enum": ["mandatory_by_law", "mandatory_by_regulation", "mandatory_by_ordinance", "contractual_or_private_rule", "indirect_pass_through"]},
          "jurisdiction": {"not": {"const": "unknown"}},
          "liable_party": {"not": {"const": "unknown"}},
          "collectors": {"type": "array", "minItems": 1, "items": {"type": "string", "not": {"const": "unknown"}}},
          "current_status": {"type": "string", "enum": ["not_applied", "active", "active_with_pending_change", "ended"]}
        }
      }
    },
    {
      "if": {"properties": {"current_status": {"type": "null"}}, "required": ["current_status"]},
      "then": {"properties": {"evidence_gaps": {"type": "array", "minItems": 1}}}
    },
    {
      "if": {"properties": {"coverage_status": {"enum": ["candidate", "needs_review"]}}, "required": ["coverage_status"]},
      "then": {"properties": {"evidence_gaps": {"type": "array", "minItems": 1}}}
    }
  ]
}
