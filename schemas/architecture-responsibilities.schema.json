{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/architecture-responsibilities.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","responsibilities","files"],
  "properties":{
    "schema_version":{"const":1},
    "responsibilities":{"const":["cli","composition_root","application","domain","adapter","test"]},
    "files":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","responsibility"],"properties":{"path":{"type":"string","pattern":"^(scripts|tests)/.+\\.js$"},"responsibility":{"enum":["cli","composition_root","application","domain","adapter","test"]}}}}
  }
}
