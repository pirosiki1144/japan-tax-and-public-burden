{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/semantic-baseline.schema.json",
  "title": "Reviewed semantic monitoring baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_at", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "tax_id", "law_id", "law_title", "revision_id", "updated_at", "source_url", "taxpayer_rules", "rates"],
        "properties": {
          "schema_version": {"const": 1},
          "tax_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "law_id": {"type": "string", "minLength": 1},
          "law_title": {"type": "string", "minLength": 1},
          "revision_id": {"type": "string", "minLength": 1},
          "updated_at": {"type": "string", "format": "date-time"},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "taxpayer_rules": {"type": "array", "minItems": 1},
          "rates": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
