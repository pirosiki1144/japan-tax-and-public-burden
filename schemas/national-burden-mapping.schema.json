{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pirosiki1144/japan-tax-and-public-burden/schemas/national-burden-mapping.schema.json",
  "title": "National burden reconciliation mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings"],
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_id", "tax_id", "status", "notes"],
        "properties": {
          "mapping_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "tax_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["included", "excluded_by_definition", "overlap", "unallocated", "missing_amount", "pending_review"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
