      "taxpayer_rules": [
        {"role": "business_operator", "article_num": "5", "paragraph_num": "1", "raw": "事業者は、国内において行つた課税資産の譲渡等につき、消費税を納める義務がある。"},
        {"role": "bonded_goods_withdrawer", "article_num": "5", "paragraph_num": "2", "raw": "外国貨物を保税地域から引き取る者は、課税貨物につき、消費税を納める義務がある。"}
      ],
      "taxable_scope_rules": [
        {"article_num": "4", "paragraph_num": "1", "raw": "国内において事業者が行つた資産の譲渡等には消費税を課する。"},
        {"article_num": "4", "paragraph_num": "2", "raw": "保税地域から引き取られる外国貨物には消費税を課する。"}
      ],
      "tax_base_rules": [
        {"article_num": "28", "paragraph_num": "1", "raw": "課税資産の譲渡等に係る消費税の課税標準は、課税資産の譲渡等の対価の額とする。"},
        {"article_num": "28", "paragraph_num": "2", "raw": "特定課税仕入れに係る消費税の課税標準は、特定課税仕入れに係る支払対価の額とする。"}
      ],
