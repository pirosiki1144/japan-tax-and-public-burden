                      {
                        "tag": "Sentence",
                        "attr": {
                          "Num": "1",
                          "WritingMode": "vertical"
                        },
                        "children": [
                          "検査自動車及び届出軽自動車には、この法律により、自動車重量税を課する。"
                        ]
                      }
                    ]
                  }
                ]
