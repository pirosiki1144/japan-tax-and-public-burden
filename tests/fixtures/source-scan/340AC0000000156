                      "２"
                    ]
                  },
                  {
                    "tag": "ParagraphSentence",
                    "attr": {},
                    "children": [
                      {
                        "tag": "Sentence",
                        "attr": {
                          "Num": "1",
                          "WritingMode": "vertical"
                        },
                        "children": [
                          "課税石油ガスを保税地域から引き取る者は、その引き取る課税石油ガスにつき、石油ガス税を納める義務がある。"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tag": "Article",
            "attr": {
              "Num": "9"
            },
