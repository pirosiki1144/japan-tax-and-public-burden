                    ]
                  },
                  {
                    "tag": "ParagraphSentence",
                    "attr": {},
                    "children": [
                      {
                        "tag": "Sentence",
                        "attr": {
                          "Num": "1",
                          "WritingMode": "vertical"
                        },
                        "children": [
                          "課税石油ガスで容量により計量されているものについての前項の重量の計算に関し必要な事項は、政令で定める。"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
