                          "WritingMode": "vertical"
                        },
                        "children": [
                          "石油ガス税の課税標準は、石油ガスの充てん場から移出し、又は保税地域から引き取る課税石油ガスの重量とする。"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "Paragraph",
                "attr": {
                  "Num": "2"
                },
                "children": [
                  {
                    "tag": "ParagraphNum",
                    "attr": {},
                    "children": [
